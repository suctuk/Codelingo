      "static/chunks/app/learn/[language]/page.js"
    ],
    "/learn/[language]/[lesson]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/learn/[language]/[lesson]/page.js"
    ],
    "/not-found": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/not-found.js"
